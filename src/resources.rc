// clang-format off

// FILEVERSION / PRODUCTVERSION take four components. Hell2Modding's rc uses
// three, which leaves VS_FIXEDFILEINFO malformed and makes Windows report no
// version at all - the strings are in the binary but nothing reads them.
// release.yml rewrites both lines, so keep the `FILEVERSION <a,b,c,d>` shape.

1 VERSIONINFO
FILEVERSION     	1,0,0,0
PRODUCTVERSION     	1,0,0,0
FILEOS          	0x4L
FILETYPE        	0x2L
BEGIN
    BLOCK       	"StringFileInfo"
    BEGIN
        BLOCK       "040904b0"
        BEGIN
            VALUE   "CompanyName",      "Hell1Modding\0"
            VALUE   "FileDescription",  "Lua Mod Loader for Hades 1\0"
            VALUE   "FileVersion",      "1.0.0" "\0"
            VALUE   "InternalName",     "d3d11\0"
            VALUE   "OriginalFilename", "d3d11.dll\0"
            VALUE   "ProductName",      "Hell1Modding\0"
            VALUE   "ProductVersion",   "1.0.0" "\0"
        END
    END

    BLOCK       	"VarFileInfo"
    BEGIN
        VALUE   	"Translation", 0x409, 1200
    END
END

    // clang-format on
